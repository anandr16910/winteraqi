# Copy this file to .env.local for local development.
# Never commit .env.local or put secrets in frontend source code.

API_BACKEND_HOST=127.0.0.1
API_BACKEND_PORT=8080
API_PAYLOAD_MAX_SIZE=10mb

GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Generate a fresh random value for local development.
# This value is not user authentication and must not be embedded in frontend code.
PROXY_HEADER=replace-with-a-long-random-local-value
